{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/director-hook.py\" SessionStart",
            "timeout": 3,
            "statusMessage": "Loading Director role boundary"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/director-hook.py\" UserPromptSubmit",
            "timeout": 3,
            "statusMessage": "Checking Director routing"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/director-hook.py\" Stop",
            "timeout": 3,
            "statusMessage": "Checking Director closeout"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/director-hook.py\" SubagentStart",
            "timeout": 3,
            "statusMessage": "Checking nested helper scope"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/director-hook.py\" SubagentStop",
            "timeout": 3,
            "statusMessage": "Checking nested helper evidence"
          }
        ]
      }
    ]
  }
}
